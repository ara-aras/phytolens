# The browser calls /v1 on its own origin and Next proxies it to the engine
# (see next.config.ts). PHYTOLENS_API_ORIGIN changes where that proxy points.
PHYTOLENS_API_ORIGIN=http://127.0.0.1:8000

# Optional: skip the proxy and call the engine directly from the browser.
# Only do this when the page and the API share an origin or CORS is configured.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
